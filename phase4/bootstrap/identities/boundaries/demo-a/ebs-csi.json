{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RegionalCsiDiscovery",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeSnapshots",
        "ec2:DescribeVolumes",
        "ec2:DescribeVolumesModifications",
        "ec2:DescribeVolumeStatus"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "CreateClusterPvcVolume",
      "Effect": "Allow",
      "Action": "ec2:CreateVolume",
      "Resource": "arn:aws:ec2:us-east-1:446517826146:volume/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ebs.csi.aws.com/cluster-name": "tc-oficina-p4-demo-a"
        }
      }
    },
    {
      "Sid": "ManageClusterPvcVolumes",
      "Effect": "Allow",
      "Action": [
        "ec2:ModifyVolume",
        "ec2:AttachVolume",
        "ec2:DetachVolume",
        "ec2:DeleteVolume"
      ],
      "Resource": "arn:aws:ec2:us-east-1:446517826146:volume/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/ebs.csi.aws.com/cluster-name": "tc-oficina-p4-demo-a"
        }
      }
    },
    {
      "Sid": "AttachClusterNodes0",
      "Effect": "Allow",
      "Action": [
        "ec2:AttachVolume",
        "ec2:DetachVolume"
      ],
      "Resource": "arn:aws:ec2:us-east-1:446517826146:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/eks:cluster-name": "tc-oficina-p4-demo-a"
        }
      }
    },
    {
      "Sid": "AttachClusterNodes1",
      "Effect": "Allow",
      "Action": [
        "ec2:AttachVolume",
        "ec2:DetachVolume"
      ],
      "Resource": "arn:aws:ec2:us-east-1:446517826146:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/eks:eks-cluster-name": "tc-oficina-p4-demo-a"
        }
      }
    },
    {
      "Sid": "AttachClusterNodes2",
      "Effect": "Allow",
      "Action": [
        "ec2:AttachVolume",
        "ec2:DetachVolume"
      ],
      "Resource": "arn:aws:ec2:us-east-1:446517826146:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/ebs.csi.aws.com/cluster-name": "tc-oficina-p4-demo-a"
        }
      }
    },
    {
      "Sid": "TagNewClusterVolumes",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:us-east-1:446517826146:volume/*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "CreateVolume",
          "aws:RequestTag/ebs.csi.aws.com/cluster-name": "tc-oficina-p4-demo-a"
        }
      }
    },
    {
      "Sid": "MaintainNonOwnershipVolumeTags",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "arn:aws:ec2:us-east-1:446517826146:volume/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/ebs.csi.aws.com/cluster-name": "tc-oficina-p4-demo-a"
        },
        "Null": {
          "aws:TagKeys": "false"
        },
        "ForAllValues:StringNotEquals": {
          "aws:TagKeys": [
            "ebs.csi.aws.com/cluster",
            "ebs.csi.aws.com/cluster-name",
            "kubernetes.io/created-for/pvc/name"
          ]
        }
      }
    }
  ]
}
