{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadExistingGithubProvider",
      "Effect": "Allow",
      "Action": "iam:GetOpenIDConnectProvider",
      "Resource": "arn:aws:iam::446517826146:oidc-provider/token.actions.githubusercontent.com"
    },
    {
      "Sid": "ManageDeclaredRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": [
        "arn:aws:iam::446517826146:role/tc-oficina-p4-demo-a-provision",
        "arn:aws:iam::446517826146:role/tc-oficina-p4-demo-a-deploy",
        "arn:aws:iam::446517826146:role/tc-oficina-p4-demo-a-destroy",
        "arn:aws:iam::446517826146:role/tc-oficina-p4-demo-a-endpoint-recovery"
      ]
    },
    {
      "Sid": "InstallInactiveRecoveryInlinePolicy",
      "Effect": "Allow",
      "Action": "iam:PutRolePolicy",
      "Resource": "arn:aws:iam::446517826146:role/tc-oficina-p4-demo-a-endpoint-recovery"
    },
    {
      "Sid": "ManageDeclaredPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": [
        "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-provision-0",
        "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-provision-1",
        "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-provision-2",
        "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-provision-3",
        "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-provision-4",
        "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-provision-5",
        "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-provision-6",
        "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-deploy-0",
        "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-deploy-1",
        "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-deploy-2",
        "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-destroy-0",
        "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-destroy-1",
        "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-destroy-2",
        "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-eks-cluster-boundary",
        "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-eks-nodes-boundary",
        "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-ebs-csi-boundary",
        "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-load-balancer-controller-boundary",
        "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-auth-lambda-boundary"
      ]
    },
    {
      "Sid": "AttachProvisionShardsOnly",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::446517826146:role/tc-oficina-p4-demo-a-provision",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": [
            "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-provision-0",
            "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-provision-1",
            "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-provision-2",
            "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-provision-3",
            "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-provision-4",
            "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-provision-5",
            "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-provision-6"
          ]
        }
      }
    },
    {
      "Sid": "AttachDeployShardsOnly",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::446517826146:role/tc-oficina-p4-demo-a-deploy",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": [
            "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-deploy-0",
            "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-deploy-1",
            "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-deploy-2"
          ]
        }
      }
    },
    {
      "Sid": "AttachDestroyShardsOnly",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::446517826146:role/tc-oficina-p4-demo-a-destroy",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": [
            "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-destroy-0",
            "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-destroy-1",
            "arn:aws:iam::446517826146:policy/tc-oficina-p4-demo-a-destroy-2"
          ]
        }
      }
    },
    {
      "Sid": "BackendBucketRegion",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::tech-challenge-oficina-terraform-state-b1cfa326",
      "Condition": {
        "StringEquals": { "s3:ResourceAccount": "446517826146" }
      }
    },
    {
      "Sid": "BackendRestrictedListing",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::tech-challenge-oficina-terraform-state-b1cfa326",
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": "446517826146",
          "s3:prefix": [
            "phase4/bootstrap/identities/demo-a.tfstate",
            "phase4/bootstrap/identities/demo-a.tfstate.tflock",
            "phase4/bootstrap/identities/demo-a-workspaces/"
          ]
        }
      }
    },
    {
      "Sid": "ReadWriteOnlyIdentityState",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::tech-challenge-oficina-terraform-state-b1cfa326/phase4/bootstrap/identities/demo-a.tfstate",
      "Condition": {
        "StringEquals": { "s3:ResourceAccount": "446517826146" }
      }
    },
    {
      "Sid": "ManageOnlyIdentityLock",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::tech-challenge-oficina-terraform-state-b1cfa326/phase4/bootstrap/identities/demo-a.tfstate.tflock",
      "Condition": {
        "StringEquals": { "s3:ResourceAccount": "446517826146" }
      }
    }
  ]
}
